    "PROB_MIXUP = 0.5\n",
    "PROB_CUTMIX = 0.5\n",
    "MIXUP_ALPHA = 0.2\n",
    "CUTMIX_ALPHA = 1.0\n",
    "\n",
    "# Warmup epochs and accumulation steps\n",
    "WARMUP_EPOCHS = 5\n",
    "EARLY_STOPPING_PATIENCE = 20\n",
    "FREEZE_EPOCHS = 5\n",
