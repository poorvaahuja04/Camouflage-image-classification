    "\n",
    "# --- 1. SETUP AND HYPERPARAMETERS (From Notebook Cell 4 & 5) ---\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(\"Device:\", device)\n",
    "\n",
    "SEED = 42\n",
    "random.seed(SEED)\n",
